<IfModule mod_rewrite.c>
  RewriteEngine On

  # Do not rewrite API calls.
  RewriteRule ^api(/|$) - [L]

  # Let real files/directories be served directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback: send all other requests to React entrypoint.
  RewriteRule . index.html [L]
</IfModule>
